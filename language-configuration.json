{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*[$%]?",
  "folding": {
    "markers": {
      "start": "^\\s*\\[(SI|ALORS|SINON|POURCHAQUE|EXTRAIRE|TANTQUE|CONDITION)\\]",
      "end": "^\\s*\\[FIN(SI|ALORS|SINON|POURCHAQUE|EXTRAIRE|TANTQUE|CONDITION)\\]"
    }
  }
}
