{
  "name": "silog-syntax",
  "displayName": "SILOG Syntax Highlighting",
  "description": "Coloration syntaxique pour le langage de script SILOG",
  "version": "0.1.0",
  "publisher": "srthibaultp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/srThibaultP/silog-syntax.git"
  },
  "bugs": {
    "url": "https://github.com/srThibaultP/silog-syntax/issues"
  },
  "homepage": "https://github.com/srThibaultP/silog-syntax#readme",
  "engines": {
    "vscode": "^1.50.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "evt",
    "act",
    "silog",
    "syntax",
    "highlighting"
  ],
  "contributes": {
    "languages": [
      {
        "id": "silog",
        "aliases": ["SILOG", "silog"],
        "extensions": [".evt", ".act"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "silog",
        "scopeName": "source.silog",
        "path": "./syntaxes/silog.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "silog",
        "path": "./snippets/silog.code-snippets"
      }
    ]
  }
}
